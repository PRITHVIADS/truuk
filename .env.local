# ──────────────────────────────────────
# Truuk — Environment Variables
# Copy this to .env.local and fill in
# ──────────────────────────────────────

# MongoDB connection string (from MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/truuk?retryWrites=true&w=majority

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Your platform domain (for tracking links)
NEXT_PUBLIC_TRACKING_DOMAIN=https://trk.truuk.io
NEXT_PUBLIC_APP_NAME=Truuk
